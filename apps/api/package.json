{
  "name": "@innoview/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../infra/api/runtime.mjs dev",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ../../infra/api/runtime.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --env-file-if-exists=../../.env --test dist-test/persistence/persistence.spec.js",
    "db:provision": "pnpm build && node --env-file-if-exists=../../.env dist/persistence/provision.cli.js",
    "db:run": "pnpm build && node --env-file-if-exists=../../.env dist/persistence/migration.cli.js run",
    "db:show": "pnpm build && node --env-file-if-exists=../../.env dist/persistence/migration.cli.js show",
    "db:create": "pnpm build && node --env-file-if-exists=../../.env dist/persistence/migration.cli.js create",
    "db:generate": "pnpm build && node --env-file-if-exists=../../.env dist/persistence/migration.cli.js generate",
    "db:revert": "pnpm build && node --env-file-if-exists=../../.env dist/persistence/migration.cli.js revert",
    "memberships:bootstrap": "pnpm build && node --env-file-if-exists=../../.env dist/memberships/bootstrap.cli.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@types/pg": "8.23.1"
  }
}
