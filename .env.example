# LOCAL DEVELOPMENT ONLY. Copy to .env and fill the empty passwords.
# Use independent random values; never use production credentials.
PLATFORM_POSTGRES_PASSWORD=
IDENTITY_POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=local_admin

# Only loopback is published. Identity PostgreSQL and management port 9000
# are available inside their Docker network only.
PLATFORM_POSTGRES_PORT=55432
KEYCLOAK_HTTP_PORT=8080

# Platform persistence only. Keycloak credentials remain completely separate.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=innoview_platform
DB_SSL=disable
DB_BOOTSTRAP_USER=platform_local_admin
# Bootstrap reuses PLATFORM_POSTGRES_PASSWORD. Never use it for the API.
DB_APP_USER=innoview_app
DB_APP_PASSWORD=
DB_MIGRATOR_USER=innoview_migrator
DB_MIGRATOR_PASSWORD=

# Separate temporary PostgreSQL (compose.test.yaml), without persistent volumes.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=55433
TEST_POSTGRES_PASSWORD=
