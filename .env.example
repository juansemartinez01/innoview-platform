# LOCAL DEVELOPMENT ONLY. Copy to .env and fill the empty passwords.
# Use independent random values; never use production credentials.
PLATFORM_POSTGRES_PASSWORD=
IDENTITY_POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=local_admin

# Only loopback is published. Identity PostgreSQL and management port 9000
# are available inside their Docker network only.
PLATFORM_POSTGRES_PORT=55432
KEYCLOAK_HTTP_PORT=8080

# Platform persistence only. Keycloak credentials remain completely separate.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=innoview_platform
DB_SSL=disable
DB_BOOTSTRAP_USER=platform_local_admin
# Bootstrap reuses PLATFORM_POSTGRES_PASSWORD. Never use it for the API.
DB_APP_USER=innoview_app
DB_APP_PASSWORD=
DB_MIGRATOR_USER=innoview_migrator
DB_MIGRATOR_PASSWORD=

# Separate temporary PostgreSQL (compose.test.yaml), without persistent volumes.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=55433
TEST_POSTGRES_PASSWORD=

# OIDC contract tests use their own in-memory Keycloak, never the local realm.
TEST_KEYCLOAK_PORT=18081
TEST_KEYCLOAK_ADMIN_PASSWORD=

# Runtime Identity: development HTTP is explicit and restricted to 127.0.0.1.
AUTH_ENV=development
AUTH_ALLOW_HTTP=true
OIDC_ISSUER=http://127.0.0.1:8080/realms/innoview
AUTH_API_ORIGIN=http://127.0.0.1:3002
PORTAL_ORIGIN=http://127.0.0.1:3000
CONTROL_ORIGIN=http://127.0.0.1:3001
DB_PORTAL_USER=innoview_portal
DB_PORTAL_PASSWORD=
DB_CONTROL_USER=innoview_control
DB_CONTROL_PASSWORD=
# Four independent random 32-byte hex values; never share keys between apps.
PORTAL_COOKIE_PASSWORD=
PORTAL_TOKEN_PASSWORD=
CONTROL_COOKIE_PASSWORD=
CONTROL_TOKEN_PASSWORD=

# Trusted membership operations ONLY. Do not inject into API/BFF deployments.
DB_MEMBERSHIP_USER=innoview_membership_operator
DB_MEMBERSHIP_PASSWORD=

# Trusted Organizations operations only; never passed to API or BFF processes.
DB_ORGANIZATIONS_USER=innoview_organizations_operator
DB_ORGANIZATIONS_PASSWORD=

# Independent trusted Authorization operator; never HTTP/BFF runtime.
DB_AUTHORIZATION_USER=innoview_authorization_operator
DB_AUTHORIZATION_PASSWORD=

# Isolated pretenant provisioner and directory maintenance, never HTTP/BFF.
DB_ORGANIZATIONS_PROVISIONER_USER=innoview_org_provisioner
DB_ORGANIZATIONS_PROVISIONER_PASSWORD=
DB_DIRECTORY_MAINTENANCE_USER=innoview_directory_maintenance
DB_DIRECTORY_MAINTENANCE_PASSWORD=

# 3.1: only API's dedicated writer pool; never BFF or global Authorization operator.
DB_AUTHORIZATION_DELEGATION_USER=innoview_authorization_delegation
DB_AUTHORIZATION_DELEGATION_PASSWORD=
