{
  "name": "innoview-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm -r --if-present test && pnpm --filter @innoview/identity-bff build && pnpm --filter @innoview/api build && node --env-file-if-exists=.env --test --test-concurrency=1 infra/keycloak/oidc.test.mjs infra/identity/runtime.test.mjs",
    "oidc:provision": "node --env-file-if-exists=.env infra/keycloak/cli.mjs provision",
    "oidc:check": "node --env-file-if-exists=.env infra/keycloak/cli.mjs check",
    "db:provision": "pnpm --filter @innoview/api db:provision",
    "db:run": "pnpm --filter @innoview/api db:run",
    "db:show": "pnpm --filter @innoview/api db:show",
    "db:create": "pnpm --filter @innoview/api db:create",
    "db:generate": "pnpm --filter @innoview/api db:generate",
    "db:revert": "pnpm --filter @innoview/api db:revert",
    "oidc:migrate:logout": "node --env-file-if-exists=.env infra/keycloak/cli.mjs migrate-logout"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "jose": "6.2.13",
    "openid-client": "6.8.8",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
